{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/*.mjs": {
      "maxDuration": 30
    }
  },
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/student-portal.html"
    },
    {
      "source": "/student",
      "destination": "/student-portal.html"
    },
    {
      "source": "/ta",
      "destination": "/ta-portal.html"
    }
  ],
  "trailingSlash": false
}
