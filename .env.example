# Optional for static demo mode. Required for the live Workspace Agent trigger.
# Public endpoint for the published PM CV Evaluator.
WORKSPACE_AGENT_ASSIGNMENT_ENDPOINT=https://api.chatgpt.com/v1/workspace_agents/agtch_6a61da53bdac819194ef01956125331e/trigger

# Alternative when you only have the exact agtch_... trigger id.
WORKSPACE_AGENT_ASSIGNMENT_TRIGGER_ID=

# Publish the Interview Evidence Probe Agent, then add its API trigger endpoint or id.
WORKSPACE_AGENT_INTERVIEW_ENDPOINT=
WORKSPACE_AGENT_INTERVIEW_TRIGGER_ID=

# Create this in ChatGPT Admin > Access tokens with Workspace Agents scope.
WORKSPACE_AGENT_ACCESS_TOKEN=

# Student portal agents use the OpenAI Responses API for synchronous structured
# results. Keep this key on the server; never expose it in student-portal.html.
OPENAI_API_KEY=

# Balanced default for student-facing quality, latency, and cost.
OPENAI_STUDENT_AGENT_MODEL=gpt-5.6-terra

# Interview Copilot consumes finalized transcript turns and returns synchronous,
# evidence-cited checkpoint or scorecard JSON. Defaults to the student model.
OPENAI_INTERVIEW_COPILOT_MODEL=gpt-5.6
